{
  "name": "steady-links",
  "version": "0.1.0",
  "description": "Edit links in a modal and reposition cursor safely",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run check && npm test && npm run bundle",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:browser": "playwright test",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run lint && npm run lint:community-review && npm run typecheck",
    "bundle": "node esbuild.config.mjs production",
    "lint:community-review": "eslint . --config eslint.community-review.config.mjs --max-warnings=0"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "Scott Otterson",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "commons": "file:../obsidian-commons",
    "esbuild": "^0.28.0",
    "eslint": "^9.20.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "fast-check": "^4.5.3",
    "globals": "^16.0.0",
    "jsdom": "^29.0.1",
    "obsidian": "~1.14.4",
    "playwright": "^1.62.1",
    "prettier": "^3.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
